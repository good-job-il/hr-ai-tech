# Frontend (Vite) local development configuration.
# Copy to .env.local and adjust as needed — .env.local is gitignored.

# Base URL used by the browser for API requests. Keep /api locally so Vite's
# development proxy is used. In Vercel, set this to the deployed API URL,
# including its /api prefix, for example https://api.example.com/api.
VITE_API_BASE_URL=/api

# Points the dev-server's "/api" proxy at the local NestJS backend
# (PORT defaults to 3001 and all routes use the /api prefix). This variable is
# only used by the local Vite development server.
VITE_API_PROXY_TARGET=http://localhost:3001
