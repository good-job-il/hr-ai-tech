{
  "name": "CandidateImportBatch",
  "type": "object",
  "properties": {
    "batch_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05ea\u05d9\u05e7\u05d9\u05d4"
    },
    "source_file": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "csv",
        "xlsx",
        "json",
        "zip"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e7\u05d5\u05d1\u05e5"
    },
    "imported_by": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05de\u05d9 \u05e9\u05d9\u05d9\u05d1\u05d0"
    },
    "employer_id": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05de\u05e2\u05e1\u05d9\u05e7"
    },
    "recruiter_id": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05de\u05d2\u05d9\u05d9\u05e1"
    },
    "total_records": {
      "type": "number",
      "description": "\u05e1\u05d4\u05f4\u05db \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05d1\u05e7\u05d5\u05d1\u05e5"
    },
    "successful_imports": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05e0\u05e7\u05dc\u05d8\u05d5 \u05d1\u05d4\u05e6\u05dc\u05d7\u05d4"
    },
    "failed_imports": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05e0\u05db\u05e9\u05dc\u05d5"
    },
    "duplicate_found": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05db\u05e4\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea"
    },
    "review_required": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d9\u05d3\u05e0\u05d9\u05ea"
    },
    "missing_email": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05d1\u05dc\u05d9 \u05d0\u05d9\u05de\u05d9\u05d9\u05dc"
    },
    "missing_phone": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05d1\u05dc\u05d9 \u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "missing_role": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05d1\u05dc\u05d9 \u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "missing_resume": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05d1\u05dc\u05d9 \u05e7\u05d5\u05e8\u05d5\u05ea \u05d7\u05d9\u05d9\u05dd"
    },
    "conversion_failures": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05db\u05e9\u05dc\u05d5 \u05d1\u05d4\u05de\u05e8\u05d4 \u05dc-DOCX"
    },
    "parsing_failures": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05db\u05e9\u05dc\u05d5 \u05d1-parsing"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d9\u05d1\u05d5\u05d0"
    },
    "error_log": {
      "type": "string",
      "description": "\u05e8\u05d9\u05e9\u05d5\u05dd \u05e9\u05d2\u05d9\u05d0\u05d5\u05ea"
    },
    "processing_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05ea\u05d7\u05d9\u05dc \u05d4\u05e2\u05d9\u05d1\u05d5\u05d3"
    },
    "processing_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05e1\u05d9\u05d9\u05dd \u05d4\u05e2\u05d9\u05d1\u05d5\u05d3"
    },
    "summary": {
      "type": "object",
      "description": "\u05e1\u05d9\u05db\u05d5\u05dd \u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d4\u05d9\u05d9\u05d1\u05d5\u05d0"
    }
  },
  "required": [
    "batch_name",
    "file_type",
    "imported_by"
  ]
}