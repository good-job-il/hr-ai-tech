{
  "name": "PermissionMatrix",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05d0\u05e8\u05d2\u05d5\u05df \u2014 null = global default template"
    },
    "org_type": {
      "type": "string",
      "enum": [
        "staffing_agency",
        "organization"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d0\u05e8\u05d2\u05d5\u05df (\u05dc\u05e6\u05d5\u05e8\u05da template matching)"
    },
    "role_key": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3: org_admin, recruitment_manager, team_manager, recruiter, hr_manager, internal_recruiter"
    },
    "is_template": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d6\u05d5 \u05e8\u05e9\u05d5\u05de\u05ea template \u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc (\u05dc\u05d0 org-specific)"
    },
    "permissions": {
      "type": "object",
      "description": "\u05de\u05e4\u05ea \u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
      "properties": {
        "view": {
          "type": "boolean",
          "default": false
        },
        "create": {
          "type": "boolean",
          "default": false
        },
        "update": {
          "type": "boolean",
          "default": false
        },
        "delete": {
          "type": "boolean",
          "default": false
        },
        "export": {
          "type": "boolean",
          "default": false
        },
        "download_cv": {
          "type": "boolean",
          "default": false
        },
        "view_compensation": {
          "type": "boolean",
          "default": false
        },
        "edit_compensation": {
          "type": "boolean",
          "default": false
        },
        "manage_users": {
          "type": "boolean",
          "default": false
        },
        "manage_settings": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "required": [
    "role_key",
    "permissions"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_template": true,
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.is_template": true,
          "user_condition": {
            "role": "super_admin"
          }
        },
        { "data.is_template": true, "data.org_type": "{{user.data.org_type}}", "user_condition": { "role": "org_admin" } },
        { "data.is_template": true, "data.org_type": "{{user.data.org_type}}", "user_condition": { "role": "recruitment_manager" } },
        { "data.is_template": true, "data.org_type": "{{user.data.org_type}}", "user_condition": { "role": "team_manager" } },
        { "data.is_template": true, "data.org_type": "{{user.data.org_type}}", "user_condition": { "role": "recruiter" } },
        { "data.is_template": true, "data.org_type": "{{user.data.org_type}}", "user_condition": { "role": "hr_manager" } },
        { "data.is_template": true, "data.org_type": "{{user.data.org_type}}", "user_condition": { "role": "internal_recruiter" } },
        { "data.organization_id": "{{user.data.organization_id}}", "user_condition": { "role": "org_admin" } },
        { "data.organization_id": "{{user.data.organization_id}}", "user_condition": { "role": "recruitment_manager" } },
        { "data.organization_id": "{{user.data.organization_id}}", "user_condition": { "role": "team_manager" } },
        { "data.organization_id": "{{user.data.organization_id}}", "user_condition": { "role": "recruiter" } },
        { "data.organization_id": "{{user.data.organization_id}}", "user_condition": { "role": "hr_manager" } },
        { "data.organization_id": "{{user.data.organization_id}}", "user_condition": { "role": "internal_recruiter" } },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}
