{
  "name": "RoleTemplate",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05d0\u05e8\u05d2\u05d5\u05df \u2014 null = global default template"
    },
    "org_type": {
      "type": "string",
      "enum": [
        "staffing_agency",
        "organization"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d0\u05e8\u05d2\u05d5\u05df"
    },
    "system_role_key": {
      "type": "string",
      "description": "\u05de\u05e4\u05ea\u05d7 \u05ea\u05e4\u05e7\u05d9\u05d3 \u05e7\u05d1\u05d5\u05e2 \u2014 \u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 (org_admin, recruiter \u05d5\u05db\u05d5')"
    },
    "display_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05ea\u05e6\u05d5\u05d2\u05d4 \u05d4\u05e0\u05d9\u05ea\u05df \u05dc\u05e2\u05e8\u05d9\u05db\u05d4 \u05e2\"\u05d9 org_admin"
    },
    "parent_role_key": {
      "type": "string",
      "description": "system_role_key \u05e9\u05dc \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05d4\u05d5\u05e8\u05d4 \u05d1\u05d4\u05d9\u05e8\u05e8\u05db\u05d9\u05d4"
    },
    "hierarchy_level": {
      "type": "number",
      "description": "\u05e8\u05de\u05ea \u05d4\u05d9\u05e8\u05e8\u05db\u05d9\u05d4 (1=\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8)"
    },
    "is_editable_name": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd org_admin \u05d9\u05db\u05d5\u05dc \u05dc\u05e9\u05e0\u05d5\u05ea \u05d0\u05ea display_name"
    },
    "is_system_required": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d7\u05d5\u05d1\u05d4 \u05d1\u05de\u05e2\u05e8\u05db\u05ea (\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d1\u05d8\u05dc)"
    },
    "permissions_template_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc PermissionMatrix template \u05d4\u05de\u05e9\u05d5\u05d9\u05da \u05dc\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d6\u05d4"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "org_type",
    "system_role_key",
    "display_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.organization_id": null,
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.organization_id": null,
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}