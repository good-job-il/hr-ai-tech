{
  "name": "SalaryData",
  "type": "object",
  "properties": {
    "job_title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "salary_avg": {
      "type": "number"
    },
    "salary_min": {
      "type": "number"
    },
    "salary_max": {
      "type": "number"
    },
    "sample_count": {
      "type": "number",
      "default": 0
    },
    "year": {
      "type": "number"
    }
  },
  "required": [
    "job_title"
  ]
}