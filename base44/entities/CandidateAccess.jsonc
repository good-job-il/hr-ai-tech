{
  "name": "CandidateAccess",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05de\u05d5\u05e2\u05de\u05d3"
    },
    "owner_organization_id": {
      "type": "string",
      "description": "\u05d4\u05d0\u05e8\u05d2\u05d5\u05df \u05e9\u05de\u05d7\u05d6\u05d9\u05e7 \u05d0\u05ea \u05d4\u05de\u05d5\u05e2\u05de\u05d3 (\u05d1\u05e2\u05dc\u05d9\u05dd \u05de\u05e7\u05d5\u05e8\u05d9\u05d9\u05dd)"
    },
    "accessor_organization_id": {
      "type": "string",
      "description": "\u05d4\u05d0\u05e8\u05d2\u05d5\u05df \u05e9\u05e7\u05d9\u05d1\u05dc \u05d2\u05d9\u05e9\u05d4 (\u05e2\u05ea\u05d9\u05d3\u05d9 \u2014 marketplace)"
    },
    "access_type": {
      "type": "string",
      "enum": [
        "owner",
        "shared",
        "purchased"
      ],
      "default": "owner",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d2\u05d9\u05e9\u05d4: owner=\u05d1\u05e2\u05dc\u05d9\u05dd, shared=\u05e9\u05d9\u05ea\u05d5\u05e3 \u05d9\u05d3\u05e0\u05d9, purchased=\u05e8\u05db\u05d9\u05e9\u05d4"
    },
    "granted_by": {
      "type": "string",
      "description": "user_id \u05e9\u05dc \u05de\u05d9 \u05e9\u05d4\u05e2\u05e0\u05d9\u05e7 \u05d2\u05d9\u05e9\u05d4"
    },
    "granted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05e0\u05d9\u05ea\u05e0\u05d4 \u05d4\u05d2\u05d9\u05e9\u05d4"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05e4\u05d5\u05e7\u05e2\u05ea (null = \u05dc\u05e6\u05de\u05d9\u05ea\u05d5\u05ea)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d2\u05d9\u05e9\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "candidate_id",
    "owner_organization_id",
    "access_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.accessor_organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}