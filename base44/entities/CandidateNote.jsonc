{
  "name": "CandidateNote",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05de\u05d5\u05e2\u05de\u05d3"
    },
    "candidate_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05d5\u05e2\u05de\u05d3"
    },
    "author_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05db\u05d5\u05ea\u05d1 \u05d4\u05d4\u05e2\u05e8\u05d4"
    },
    "author_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05db\u05d5\u05ea\u05d1 \u05d4\u05d4\u05e2\u05e8\u05d4"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "recruiter",
        "team_manager",
        "recruitment_manager",
        "admin"
      ],
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05db\u05d5\u05ea\u05d1"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05e2\u05e8\u05d4"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "internal",
        "employer_visible",
        "all"
      ],
      "default": "internal",
      "description": "\u05de\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e8\u05d0\u05d5\u05ea \u05d0\u05ea \u05d4\u05d4\u05e2\u05e8\u05d4"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d4\u05e2\u05e8\u05d4 \u05de\u05d5\u05e6\u05de\u05d3\u05ea"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "general",
        "interview_feedback",
        "status_change",
        "document_request",
        "system"
      ],
      "default": "general"
    },
    "related_application_id": {
      "type": "string",
      "description": "ID \u05de\u05d5\u05e2\u05de\u05d3\u05d5\u05ea \u05e7\u05e9\u05d5\u05e8\u05d4"
    },
    "related_interview_id": {
      "type": "string",
      "description": "ID \u05e8\u05d0\u05d9\u05d5\u05df \u05e7\u05e9\u05d5\u05e8"
    }
  },
  "required": [
    "candidate_id",
    "content",
    "author_email"
  ]
}