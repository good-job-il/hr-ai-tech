{
  "name": "JobAlert",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "keywords": {
      "type": "string",
      "description": "\u05de\u05d9\u05dc\u05d5\u05ea \u05de\u05e4\u05ea\u05d7 \u05dc\u05d7\u05d9\u05e4\u05d5\u05e9"
    },
    "location": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "full",
        "part",
        "remote",
        "daily",
        "any"
      ],
      "default": "any"
    },
    "salary_min": {
      "type": "number"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly"
      ],
      "default": "daily"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_sent": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ]
}