{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "initials": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "logo_url": {
      "type": "string",
      "description": "URL of the company logo"
    },
    "website": {
      "type": "string",
      "description": "Public company website"
    },
    "job_count": {
      "type": "number",
      "default": 0
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft delete \u2014 \u05d4\u05d0\u05dd \u05d4\u05d7\u05d1\u05e8\u05d4 \u05e0\u05de\u05d7\u05e7\u05d4"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d1\u05d5\u05e6\u05e2 \u05d4-soft delete"
    },
    "deleted_by": {
      "type": "string",
      "description": "user_id \u05e9\u05dc \u05de\u05d9 \u05e9\u05de\u05d7\u05e7"
    }
  },
  "required": [
    "name"
  ]
}
