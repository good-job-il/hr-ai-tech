{
  "name": "CandidateDocument",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05d0\u05e8\u05d2\u05d5\u05df (Multi-Tenant isolation)"
    },
    "candidate_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05de\u05d5\u05e2\u05de\u05d3"
    },
    "candidate_email": {
      "type": "string"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "cv",
        "cover_letter",
        "portfolio",
        "certificate",
        "contract",
        "id",
        "other"
      ],
      "default": "cv"
    },
    "filename": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "file_url": {
      "type": "string",
      "description": "URL \u05dc\u05e7\u05d5\u05d1\u05e5 (DOCX \u05d0\u05dd \u05d1\u05d5\u05e6\u05e2\u05d4 \u05d4\u05de\u05e8\u05d4, \u05d0\u05d7\u05e8\u05ea \u05de\u05e7\u05d5\u05e8\u05d9)"
    },
    "original_file_url": {
      "type": "string",
      "description": "URL \u05dc\u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9 (\u05dc\u05e4\u05e0\u05d9 \u05d4\u05de\u05e8\u05d4)"
    },
    "original_file_type": {
      "type": "string",
      "enum": [
        "pdf",
        "doc",
        "docx",
        "txt",
        "other"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "original_filename": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "docx_url": {
      "type": "string",
      "description": "URL \u05dc\u05d2\u05e8\u05e1\u05ea DOCX (\u05ea\u05de\u05d9\u05d3 \u05e0\u05d5\u05e6\u05e8\u05ea)"
    },
    "docx_filename": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e7\u05d5\u05d1\u05e5 \u05d4-DOCX \u05e9\u05e0\u05d5\u05e6\u05e8"
    },
    "file_size": {
      "type": "number"
    },
    "uploaded_by": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05de\u05d9 \u05e9\u05d4\u05e2\u05dc\u05d4"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e2\u05dc\u05d0\u05d4"
    },
    "is_latest_cv": {
      "type": "boolean",
      "default": false
    },
    "conversion_status": {
      "type": "string",
      "enum": [
        "pending",
        "success",
        "failed",
        "not_needed"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05de\u05e8\u05d4 \u05dc-DOCX"
    },
    "conversion_error": {
      "type": "string",
      "description": "\u05e9\u05d2\u05d9\u05d0\u05ea \u05d4\u05de\u05e8\u05d4 \u05d0\u05dd \u05e0\u05db\u05e9\u05dc\u05d4"
    },
    "parsing_status": {
      "type": "string",
      "enum": [
        "pending",
        "success",
        "partial",
        "failed",
        "not_attempted"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 parsing \u05e9\u05dc \u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05d7\u05d9\u05d9\u05dd"
    },
    "parsing_error": {
      "type": "string",
      "description": "\u05e9\u05d2\u05d9\u05d0\u05ea parsing \u05d0\u05dd \u05e0\u05db\u05e9\u05dc\u05d4"
    },
    "parsed_data": {
      "type": "object",
      "description": "\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05e9\u05e0\u05d7\u05dc\u05e6\u05d5 \u05de\u05d4-parsing (full_name, phone, email, skills, etc.)"
    },
    "import_batch_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc batch \u05d4\u05d9\u05d9\u05d1\u05d5\u05d0"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "doc_type",
    "file_url"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}