{
  "name": "JobTimeline",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "ID of the job"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "created",
        "published",
        "updated",
        "closed",
        "imported",
        "received_application",
        "shared_with_team",
        "status_changed",
        "note_added"
      ],
      "description": "Type of event"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "metadata": {
      "type": "object",
      "description": "Additional context (application_count, publisher_email, etc.)"
    }
  },
  "required": [
    "job_id",
    "event_type",
    "description"
  ]
}