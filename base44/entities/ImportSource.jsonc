{
  "name": "ImportSource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e7\u05d5\u05e8"
    },
    "provider": {
      "type": "string",
      "description": "\u05e1\u05e4\u05e7 (JobMaster, Drushim, AllJobs \u05d5\u05db\u05d5')"
    },
    "url": {
      "type": "string",
      "description": "URL \u05dc\u05e4\u05d9\u05d3 \u05d4\u05de\u05e9\u05e8\u05d5\u05ea"
    },
    "interval_hours": {
      "type": "number",
      "default": 6,
      "description": "\u05db\u05dc \u05db\u05de\u05d4 \u05e9\u05e2\u05d5\u05ea \u05dc\u05e1\u05e0\u05db\u05e8\u05df"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_sync": {
      "type": "string",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05e0\u05db\u05e8\u05d5\u05df \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "last_sync_status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "pending"
      ],
      "default": "pending"
    },
    "last_error": {
      "type": "string",
      "description": "\u05d4\u05d5\u05d3\u05e2\u05ea \u05e9\u05d2\u05d9\u05d0\u05d4 \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    },
    "jobs_added": {
      "type": "number",
      "default": 0
    },
    "jobs_updated": {
      "type": "number",
      "default": 0
    },
    "jobs_closed": {
      "type": "number",
      "default": 0
    },
    "logs": {
      "type": "string",
      "description": "\u05dc\u05d5\u05d2\u05d9\u05dd \u05d0\u05d7\u05e8\u05d5\u05e0\u05d9\u05dd"
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea retry"
    },
    "last_retry_attempt": {
      "type": "string",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e0\u05d9\u05e1\u05d9\u05d5\u05df retry \u05d0\u05d7\u05e8\u05d5\u05df"
    }
  },
  "required": [
    "name",
    "url"
  ]
}