{
  "name": "Position",
  "type": "object",
  "properties": {
    "company_email": {
      "type": "string",
      "description": "Email of the hiring manager who owns this position"
    },
    "title": {
      "type": "string",
      "description": "Position title"
    },
    "department": {
      "type": "string",
      "description": "Department name"
    },
    "description": {
      "type": "string",
      "description": "Position description and responsibilities"
    },
    "required_experience": {
      "type": "number",
      "description": "Years of experience required"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required skills"
    },
    "salary_min": {
      "type": "number"
    },
    "salary_max": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this position is active"
    }
  },
  "required": [
    "company_email",
    "title"
  ]
}