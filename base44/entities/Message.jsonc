{
  "name": "Message",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string",
      "description": "The application this conversation belongs to"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "employer",
        "candidate"
      ]
    },
    "content": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "application_id",
    "sender_email",
    "content"
  ]
}