{
  "name": "CandidateTimeline",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05d0\u05e8\u05d2\u05d5\u05df (Multi-Tenant isolation)"
    },
    "candidate_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05de\u05d5\u05e2\u05de\u05d3"
    },
    "candidate_email": {
      "type": "string",
      "description": "Email of the candidate"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "registered",
        "resume_uploaded",
        "resume_converted",
        "parsing_completed",
        "parsing_failed",
        "duplicate_detected",
        "imported",
        "application_submitted",
        "application_viewed",
        "interview_scheduled",
        "interview_completed",
        "interview_cancelled",
        "status_changed",
        "note_added",
        "offer_received",
        "hired",
        "rejected",
        "tag_added",
        "tag_removed",
        "recruiter_assigned",
        "document_uploaded",
        "message_sent",
        "message_received",
        "employer_viewed",
        "sent_to_employer"
      ],
      "description": "Type of event"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "performed_by": {
      "type": "string",
      "description": "Email of who performed the action"
    },
    "performed_by_name": {
      "type": "string",
      "description": "Name of who performed the action"
    },
    "performed_by_role": {
      "type": "string",
      "enum": [
        "candidate",
        "recruiter",
        "team_manager",
        "recruitment_manager",
        "org_admin",
        "employer",
        "admin",
        "system"
      ]
    },
    "metadata": {
      "type": "object",
      "description": "Additional context (job_id, application_id, interview_id, old_value, new_value)"
    },
    "is_visible_to_candidate": {
      "type": "boolean",
      "default": false
    },
    "is_visible_to_employer": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "candidate_id",
    "event_type",
    "description"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}