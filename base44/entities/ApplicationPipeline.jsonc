{
  "name": "ApplicationPipeline",
  "type": "object",
  "properties": {
    "employer_id": {
      "type": "string",
      "description": "Email of the employer who owns this pipeline"
    },
    "name": {
      "type": "string",
      "description": "Stage name (e.g., \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4, \u05e8\u05d0\u05d9\u05d5\u05df, \u05d4\u05e6\u05e2\u05d4, \u05d4\u05ea\u05e7\u05d1\u05dc)"
    },
    "order": {
      "type": "number",
      "description": "Order of the stage in the pipeline"
    },
    "color": {
      "type": "string",
      "description": "Color for the stage card (hex code)"
    }
  },
  "required": [
    "employer_id",
    "name"
  ]
}