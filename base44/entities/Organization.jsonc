{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05e8\u05d2\u05d5\u05df"
    },
    "org_type": {
      "type": "string",
      "enum": [
        "staffing_agency",
        "organization"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d0\u05e8\u05d2\u05d5\u05df: \u05d7\u05d1\u05e8\u05ea \u05d4\u05e9\u05de\u05d4 \u05d0\u05d5 \u05d0\u05e8\u05d2\u05d5\u05df \u05e8\u05d2\u05d9\u05dc"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "inactive"
      ],
      "default": "active",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d0\u05e8\u05d2\u05d5\u05df"
    },
    "settings": {
      "type": "object",
      "description": "\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05dc\u05d0\u05e8\u05d2\u05d5\u05df (JSON \u05d7\u05d5\u05e4\u05e9\u05d9)"
    },
    "plan": {
      "type": "string",
      "enum": [
        "trial",
        "starter",
        "pro",
        "enterprise"
      ],
      "default": "trial",
      "description": "\u05d7\u05d1\u05d9\u05dc\u05ea \u05de\u05e0\u05d5\u05d9"
    },
    "contact_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e8\u05d0\u05e9\u05d9 \u05e9\u05dc \u05d4\u05d0\u05e8\u05d2\u05d5\u05df"
    },
    "logo_url": {
      "type": "string",
      "description": "\u05dc\u05d5\u05d2\u05d5 \u05d4\u05d0\u05e8\u05d2\u05d5\u05df"
    }
  },
  "required": [
    "name",
    "org_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}