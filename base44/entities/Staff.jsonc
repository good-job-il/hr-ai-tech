{
  "name": "Staff",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company identifier (hiring manager email)"
    },
    "full_name": {
      "type": "string",
      "description": "Staff member's full name"
    },
    "email": {
      "type": "string",
      "description": "Staff member's email"
    },
    "phone": {
      "type": "string",
      "description": "Staff member's phone"
    },
    "role": {
      "type": "string",
      "enum": [
        "hiring_manager",
        "team_manager",
        "recruiter"
      ],
      "description": "Staff role"
    },
    "manager_email": {
      "type": "string",
      "description": "Email of the direct manager (hiring manager or team manager)"
    }
  },
  "required": [
    "company_id",
    "full_name",
    "email",
    "phone",
    "role"
  ]
}